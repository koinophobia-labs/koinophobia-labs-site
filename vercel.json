{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.koinophobia.dev"
        }
      ],
      "destination": "https://koinophobialabs.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.koinophobialabs.com"
        }
      ],
      "destination": "https://koinophobialabs.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/appstore/financial-true-up",
      "schedule": "15 8 8 * *"
    },
    {
      "path": "/api/jobs/tick",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/appstore/reconcile",
      "schedule": "*/10 * * * *"
    }
  ]
}
